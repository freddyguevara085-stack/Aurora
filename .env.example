SECRET_KEY=replace-with-a-long-random-development-key
# Entorno de configuración: development | testing | production
AURORA_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=aurora
MYSQL_USER=root
MYSQL_PASSWORD=
# Railway: también admite MYSQL_URL o DATABASE_URL (mysql://...).
# No pegues las credenciales reales en este archivo.
# AURORA_DEMO_PASSWORD= (opcional, mínimo 12 caracteres; crea la cuenta demo al desplegar)

# Debug y sesión
AURORA_DEBUG=0
SESSION_COOKIE_SECURE=0
PORT=5000

# SMTP para recuperación de contraseña
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
